{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "UUID": "com.adamperri.soundclouddial.control",
      "Name": "SoundCloud Dial",
      "Icon": "assets/action",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/player.json",
        "Icon": "assets/dial",
        "StackColor": "#ff6500",
        "TriggerDescription": {
          "Rotate": "SoundCloud volume",
          "Push": "Play / Pause",
          "Touch": "Play / Pause"
        }
      },
      "PropertyInspectorPath": "ui/index.html",
      "States": [
        {
          "Image": "assets/cover",
          "ShowTitle": false
        }
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Tooltip": "Current track artwork, SoundCloud app volume and play/pause. Requires the SoundCloud Windows desktop app."
    }
  ],
  "Author": "Adamperri",
  "CodePath": "bin/plugin.js",
  "Description": "Unofficial SoundCloud desktop controls with live cover art, per-app volume, and dial-press play/pause. Windows x64 only.",
  "Icon": "assets/plugin",
  "Name": "Cloud Dial for SoundCloud",
  "Category": "Cloud Dial for SoundCloud",
  "CategoryIcon": "assets/category",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "UUID": "com.adamperri.soundclouddial",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.5"
  },
  "URL": "https://github.com/Adamperri/soundcloud-dial",
  "SupportURL": "https://github.com/Adamperri/soundcloud-dial/issues"
}