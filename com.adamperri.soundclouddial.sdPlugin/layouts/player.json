{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "cloud-dial-player",
  "items": [
    { "key": "base", "type": "pixmap", "rect": [0, 0, 200, 100], "background": "#111214", "zOrder": 0 },
    { "key": "artwork", "type": "pixmap", "rect": [4, 3, 88, 88], "value": "assets/cover.png", "zOrder": 1 },
    { "key": "connection", "type": "text", "rect": [98, 3, 98, 14], "font": { "size": 10, "weight": 600 }, "color": "#ff7828", "alignment": "left", "value": "SOUNDCLOUD", "zOrder": 1 },
    { "key": "track", "type": "pixmap", "rect": [98, 22, 96, 24], "value": "assets/idle-title.png", "zOrder": 1 },
    { "key": "artist", "type": "text", "rect": [98, 47, 98, 18], "font": { "size": 12, "weight": 400 }, "color": "#b9bdc5", "alignment": "left", "text-overflow": "ellipsis", "value": "Desktop app", "zOrder": 1 },
    { "key": "playback", "type": "pixmap", "rect": [98, 71, 18, 18], "value": "assets/play.png", "zOrder": 1 },
    { "key": "progress", "type": "bar", "rect": [122, 76, 27, 6], "value": 0, "enabled": false, "subtype": 0, "border_w": 0, "bar_bg_c": "#303238", "bar_fill_c": "#55d5b7", "zOrder": 1 },
    { "key": "level", "type": "text", "rect": [153, 68, 43, 24], "font": { "size": 16, "weight": 600 }, "color": "#ffffff", "alignment": "right", "value": "--", "zOrder": 1 },
    { "key": "meter", "type": "bar", "rect": [4, 95, 192, 3], "value": 0, "subtype": 0, "border_w": 0, "bar_bg_c": "#303238", "bar_fill_c": "#ff6500", "zOrder": 1 }
  ]
}
