{
  "name": "cloud-dial-for-soundcloud",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "streamdeck validate com.adamperri.soundclouddial.sdPlugin",
    "pack": "streamdeck pack com.adamperri.soundclouddial.sdPlugin --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@types/node": "22.20.3",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "lucide-static": "1.46.0",
    "sharp": "0.35.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  }
}
